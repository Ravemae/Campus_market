# Campus Market — Environment Variables
# Copy this file to .env and fill in the values

# JWT Secret Key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Database URL
# SQLite (local development):
DATABASE_URL=sqlite:///./app.db
# PostgreSQL (Supabase — for production):
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Paystack API Keys (get from https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_your_key_here

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-key-here

# Resend API Key (get from https://resend.com/api-keys)
RESEND_API_KEY=re_your-resend-key-here

# App Email (Gmail used for sending OTP emails)
MAIL_EMAIL=your-app-email@gmail.com